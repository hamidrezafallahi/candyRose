# =============================================================================
# candyRose production env template (NO secrets — copy to .env on VPS)
# =============================================================================

# PostgreSQL
POSTGRES_DB=OnlineShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (backend)
JWT_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ISSUER=OnlineShop
JWT_AUDIENCE=OnlineShopUsers

# Immutable image tags (set by deploy.sh — never rely on :latest for prod)
FRONTEND_IMAGE_TAG=
BACKEND_IMAGE_TAG=

# Hangfire dashboard (keep false; nginx IP-restricts /hangfire)
HANGFIRE_DASHBOARD_ENABLED=false

# Optional first-boot admin (skipped if user already exists)
SEED_ADMIN_PASSWORD=

# Optional local port mapping (compose may not expose backend publicly)
BACKEND_PORT=8080

# Frontend → backend (Docker network). Browser calls go through nginx /api.
# INTERNAL_SERVER_SIDE_API_URL must be the backend origin WITHOUT a trailing slash.
# FrontEnd ensureApiSuffix() appends /api → http://backend:8080/api/...
INTERNAL_SERVER_SIDE_API_URL=http://backend:8080
# Legacy/fallback only; prefer INTERNAL_SERVER_SIDE_API_URL above.
NEXT_PUBLIC_INTERNAL_API_URL=http://backend:8080

# Public site URL (SEO / absolute links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Docker Hub / compose
DOCKER_USERNAME=your-dockerhub-username
COMPOSE_PROJECT_NAME=shop

# Nginx / TLS
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=www.example.com
SERVER_IP=YOUR.PUBLIC.OR.OFFICE.IP
CERTBOT_EMAIL=you@example.com
RENEW_INTERVAL=12h

# Optional tooling (docker-compose.tools.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PORTAINER_PORT=9000
