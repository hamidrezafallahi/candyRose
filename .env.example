# =============================================================================
# candyRose production env template (NO secrets — copy to .env on VPS)
# =============================================================================

# PostgreSQL
POSTGRES_DB=OnlineShopDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=H@mid1991

# JWT (backend)
JWT_KEY=oP+8s8cH9Z2K3n0Q4b1Vd3t6W+XjR7LqF5aM8zYhQvN1uC6pR0sTgH2kJ9lE4wF7
JWT_ISSUER=OnlineShop
JWT_AUDIENCE=OnlineShopUsers

# Immutable image tags (set by deploy.sh — never rely on :latest for prod)
FRONTEND_IMAGE_TAG=22191f62c658f3f44e868757b68fb44d89df052c
BACKEND_IMAGE_TAG=22191f62c658f3f44e868757b68fb44d89df052c

# Hangfire dashboard (keep false; nginx IP-restricts /hangfire)
HANGFIRE_DASHBOARD_ENABLED=false

# Optional first-boot admin (skipped if user already exists)
SEED_ADMIN_PASSWORD=

# Optional local port mapping (compose may not expose backend publicly)
BACKEND_PORT=8080

# Frontend → backend (Docker network). Browser calls go through nginx /api.
INTERNAL_SERVER_SIDE_API_URL=http://backend:8080
NEXT_PUBLIC_INTERNAL_API_URL=http://backend:8080

# Public site URL (SEO / absolute links)
NEXT_PUBLIC_SITE_URL=https://rooshakshop.com
NEXT_PUBLIC_SITE_NAME=rooshakshop.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification=lE-XxyDl8flAYOkOhfzXMjEI1iBy_wDCywUhPu3GbXk

# Docker Hub / compose
DOCKER_USERNAME=hamidrezafalahi
COMPOSE_PROJECT_NAME=shop

# Nginx / TLS
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=rooshakshop.com
SERVER_IP=188.240.196.165
CERTBOT_EMAIL=hamidreza.lipar@gmail.com
RENEW_INTERVAL=12h

# Optional tooling (docker-compose.tools.yml)
PGADMIN_EMAIL=hamidreza.lipar@gmail.com
PGADMIN_PASSWORD=Hamid1991
PORTAINER_PORT=9000

# ─── Content automation (backend seeds ContentEditor) ───────────────────────
ContentAutomation__AdminBaseUrl=https://rooshakshop.com
ContentAutomation__ServiceAccountName=Content Admin
ContentAutomation__ServiceAccountEmail=content-bot@onlineshop.local
ContentAutomation__ServiceAccountPassword=ContentBot@123

# ─── n8n ────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
WEBHOOK_URL=http://127.0.0.1:5678/
GENERIC_TIMEZONE=Asia/Tehran
TZ=Asia/Tehran
N8N_SECURE_COOKIE=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_LICENSE_KEY=

# ─── AI blog automation (n8n workflow $env.*) ───────────────────────────────
API_BASE_URL=http://backend:8080/api
CONTENT_BOT_EMAIL=content-bot@onlineshop.local
CONTENT_BOT_PASSWORD=ContentBot@123
CONTENT_BOT_NAME=Content Admin
CONTENT_ADMIN_BASE_URL=https://rooshakshop.com
SEED_TOPICS_JSON=["ظروف کریستال","ظروف دکوری"]

# Free LLM: Groq — https://console.groq.com
GROQ_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
OPENAI_API_KEY=

# Optional — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Swagger
Swagger__Enabled=true
